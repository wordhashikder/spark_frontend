# PickASparky website configuration.
# Copy to `.env.local` for local development. In production set these in Coolify.

# Public URL of this site, no trailing slash. Used for canonical URLs, the sitemap
# and social tags. It is inlined at BUILD time, so it must also be a build variable.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base URL of the FastAPI backend, as reachable from the Next.js SERVER
# (the browser never calls the API). Read at runtime.
API_URL=http://localhost:8000

# Shared secret with the API (must equal the backend's INTERNAL_API_KEY).
# Lets the API rate-limit public forms per visitor. Required in production.
INTERNAL_API_KEY=dev-internal-key

# Optional social profile links shown in the footer. Leave blank to hide the icons.
NEXT_PUBLIC_SOCIAL_X_URL=
NEXT_PUBLIC_SOCIAL_LINKEDIN_URL=
